{
  "redirects": [
    {
      "source": "/bankdash",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/bankdash/:path*",
      "destination": "/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ]
}
